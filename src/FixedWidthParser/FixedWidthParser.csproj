<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Enables [SkipLocalsInit] on the write hot path (no actual unsafe code is used). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Ship XML docs (members without a doc comment do not warn). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
    <!-- Directory.Build.props silences public-API tracking for every project; the shipped library
         turns RS0016/RS0037 back on so PublicAPI.*.txt records every public member.
         S2743: per-closed-type static caches are the point of the generic parser/writer.
         CA1720: FixedWidthRuntime.String is called by generated code; renaming it buys nothing.
         S3011: the factories reflect over their own private builders. -->
    <NoWarn>$([System.String]::Copy('$(NoWarn)').Replace('RS0016', '').Replace('RS0037', ''));CS1591;S2743;CA1720;S3011</NoWarn>
  </PropertyGroup>

  <!-- Pack fails on any binary break against the baseline; move it to each new release. The 2.0
       breaks against 1.1.1 are listed, deliberately, in CompatibilitySuppressions.xml; delete that
       file when the baseline moves to 2.0.0. -->
  <PropertyGroup>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.1.1</PackageValidationBaselineVersion>
  </PropertyGroup>

  <!-- NuGet package metadata -->
  <PropertyGroup>
    <!-- The bare "FixedWidthParser" id is squatted on nuget.org; assembly/namespace stay FixedWidthParser. -->
    <PackageId>FixedWidthParser.NET</PackageId>
    <Version>2.0.0-dev</Version>
    <Authors>Gabriel Matte</Authors>
    <Title>FixedWidthParser</Title>
    <Description>High-performance, low-allocation parsing and writing of fixed-width (flat) files for .NET. Attribute-driven column mapping, sync/async batch reading (IEnumerable/IAsyncEnumerable), configurable formatting, culture awareness and ref struct support.</Description>
    <PackageTags>fixed-width;flat-file;parser;writer;parsing;serialization;performance;span;low-allocation</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/GabrielMarquezMatte/FixedWidthParser</PackageProjectUrl>
    <RepositoryUrl>https://github.com/GabrielMarquezMatte/FixedWidthParser</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>See the changelog: https://github.com/GabrielMarquezMatte/FixedWidthParser/blob/master/CHANGELOG.md</PackageReleaseNotes>
    <Copyright>Copyright (c) Gabriel Matte</Copyright>
  </PropertyGroup>

  <PropertyGroup>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.HighPerformance" Version="8.4.2" />
    <PackageReference Include="csFastFloat" Version="4.1.6" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FixedWidthParser.Generator\FixedWidthParser.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_AddGeneratorToPackage</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <Target Name="_AddGeneratorToPackage" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(Analyzer)"
                              Condition="'%(Analyzer.Filename)' == 'FixedWidthParser.Generator'"
                              PackagePath="analyzers/dotnet/cs/%(Analyzer.Filename)%(Analyzer.Extension)" />
    </ItemGroup>
  </Target>

</Project>

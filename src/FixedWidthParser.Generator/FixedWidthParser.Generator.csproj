<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- Shipped bundled inside the FixedWidthParser package as an analyzer, not as its own package. -->
    <IsPackable>false</IsPackable>
    <!-- Emit a portable PDB even in Release so code-coverage tooling can instrument the generator.
         Directory.Build.props sets DebugType=none for Release; override it here. The PDB is not packed
         (IncludeBuildOutput is false; only the analyzer DLL is added to the package). -->
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <!-- Release tracking is for shipped analyzers; not needed for this in-repo generator. -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
